# ============================================
# VANTRO FLOW FRONTEND — Environment Variables
# Copy to .env.local for local dev
# Set in Vercel Dashboard for production
# ============================================

# Backend URL (Railway) — the origin every API call, including login, goes to.
# This value also feeds the Content-Security-Policy connect-src in
# next.config.js, so changing it here is enough; there is no second place to
# update. It is read at BUILD time, so redeploy after changing it in Vercel.
# For a local backend: NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=https://vantro-flow-backend-production.up.railway.app

# Analytics (PostHog) — safe to be public
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
