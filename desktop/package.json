{
  "name": "starlane-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starlane for Windows and macOS: native shell (Tauri) around a purpose-built interface, with the local Tally connector host.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "icons": "node scripts/make-icon.mjs && tauri icon icon-source.png",
    "e2e:preview": "python3 scripts/e2e-preview.py"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.6.0",
    "@tauri-apps/plugin-deep-link": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.3",
    "vite": "^8.3.1"
  }
}
