{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starlane",
  "mainBinaryName": "Starlane",
  "version": "0.1.4",
  "identifier": "app.starlane.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Starlane",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "Starlane",
    "category": "Business",
    "shortDescription": "Starlane: decisions and action from your company’s real data",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "© Starlane",
    "longDescription": "Starlane connects to the systems your business already runs on (TallyPrime on this computer, or file exports), shows what needs a decision with the evidence for each, and carries out approved actions."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "starlane"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
